# ============================================
# CountOnMe Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment

# ----------------------
# Client (React Native / Expo)
# ----------------------

# API URL for development
# Use your computer's IP address so the mobile device can reach the backend
# Find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000

# ----------------------
# Backend (FastAPI)
# ----------------------

ENV=local

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Database
# For local development with docker-compose, use:
DATABASE_URL=postgresql+asyncpg://countonme:countonme@localhost:5433/countonme
# For docker network (api container to db container), use:
# DATABASE_URL=postgresql+asyncpg://countonme:countonme@db:5432/countonme

# Auth (Legacy — device tokens, will be deprecated)
# Used to derive/verify device tokens (keep secret in production!)
# Generate a strong pepper: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_TOKEN_PEPPER=

# ----------------------
# Supabase
# ----------------------

# Supabase project URL (found in Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (found in API Keys → Publishable and secret API keys)
# Format: sb_publishable_... (use the new key, not the legacy anon JWT)
# Safe to embed in client apps when RLS is enabled
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (found in API Keys → Publishable and secret API keys → Secret keys)
# Format: sb_secret_... (use the new key, not the legacy service_role JWT)
# Used by FastAPI for admin operations (e.g., deleting auth users on account deletion)
# NEVER expose this to the client — backend only!
SUPABASE_SECRET_KEY=

# Supabase JWT secret (found in Project Settings → API → JWT Settings)
# Used by FastAPI to verify Supabase access tokens
SUPABASE_JWT_SECRET=

# Supabase database connection string (found in Project Settings → Database)
# For FastAPI direct connection to Supabase Postgres:
# SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ----------------------
# Client (Supabase)
# ----------------------

# These are embedded in the Expo app at build time
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the publishable key (sb_publishable_...) — same value as SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_ANON_KEY=
