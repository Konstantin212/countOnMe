{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git ls-tree*)",
      "Bash(cd client && npm*)",
      "Bash(cd client && npx*)",
      "Bash(cd backend && ruff*)",
      "Bash(cd backend && pytest*)",
      "Bash(cd backend && poetry*)",
      "Bash(node -c*)",
      "Bash(node -e*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "mcp__github__get_me",
      "mcp__github__get_file_contents",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__search_code",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__create_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/block-random-md.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/pre-write-env-block.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/pre-write-client-structure.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/pre-write-backend-structure.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/git-push-warn.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/pre-bash-destructive-warn.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/pre-commit-doc-review.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/suggest-compact.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-typecheck.js",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-lint-python.js",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-console-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-format.js",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-ts-any-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-inline-style-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-py-print-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-secret-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-router-sql-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-screen-storage-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-nesting-warn.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/post-edit-doc-lint.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/check-console-log.js",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/stop-file-size-check.js",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/stop-function-length-check.js",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/cot/countOnMe/.claude/hooks/stop-device-scope-check.js",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "fe-developer",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Review all recent client/ changes. Run `cd client && git diff HEAD -- '*.ts' '*.tsx'` to find changes. If no client changes, output 'No client changes to review' and stop. Otherwise: 1) Run `cd client && npx tsc --noEmit 2>&1 | head -80` for type errors. 2) Read each changed file. 3) Check: theme colors from useTheme() not hardcoded hex, particle usage for forms (FormField/Input from @particles), hook state immutability (no .push/.splice mutations), no raw setState exposure from hooks, no console.log with tokens, import aliases (@hooks/@models/@services) for cross-folder imports, StyleSheet.create not inline styles, FlatList for lists not ScrollView+map. 4) Output structured report: CRITICAL/HIGH/MEDIUM/LOW findings with file:line, then verdict APPROVE/CHANGES REQUESTED/BLOCKED.",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "backend-developer",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Review all recent backend/ changes. Run `cd backend && git diff HEAD -- '*.py'` to find changes. If no backend changes, output 'No backend changes to review' and stop. Otherwise: 1) Run `cd backend && ruff check app/ 2>&1 | head -80`. 2) Read each changed file. 3) Check: device_id scoping on EVERY query, deleted_at.is_(None) soft-delete filter, no SQL in routers (service layer only), type hints on public functions, no hardcoded secrets, bcrypt token hashing (never plaintext), parameterized queries (no f-strings in SQL), async-only DB calls, transaction safety (async with session.begin() for multi-step mutations), cross-device access returns 404 not 403. 4) Output structured report: CRITICAL/HIGH/MEDIUM/LOW findings with file:line, then verdict APPROVE/CHANGES REQUESTED/BLOCKED.",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
